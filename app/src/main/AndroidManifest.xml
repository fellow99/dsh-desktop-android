<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- 通知（agent 审批/完成提醒；33+ 运行时请求，拒绝则静默降级） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 前台服务：仅 agent turn 运行期保活（docs/000 §6.6） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".DshApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Dsh"
        android:usesCleartextTraffic="false">

        <!-- singleTask：多实例会争 filesDir 与端口（docs/000 §4.2） -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- SAF 两段式委托页（fs.pickFiles / fs.saveFile）：透明、不入最近任务 -->
        <activity
            android:name=".host.PickDelegateActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />

        <!-- AgentKeepAlive（specs/109）：turn 运行期 dataSync 保活，turn 结束即停 -->
        <service
            android:name=".host.KeepAliveService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- T-005：工作区文件只读共享（content:// + FLAG_GRANT_READ），ACTION_VIEW 打开工作区文件 -->
        <provider
            android:name=".host.WorkspaceFilesProvider"
            android:authorities="org.fellow99.dsh.android.workspacefiles"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>

</manifest>
